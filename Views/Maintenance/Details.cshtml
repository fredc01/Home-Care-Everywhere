@model HomeCarePH.Models.MaintenanceDetailsViewModel
@using HomeCarePH.Domain.Entities
@{ ViewData["Title"] = Model.Task.Title; var canEdit = Model.CurrentRole is HouseholdRole.Owner or HouseholdRole.Admin or HouseholdRole.Member; var overdue = Model.Task.IsActive && Model.Task.NextDueDate < DateOnly.FromDateTime(DateTime.UtcNow); }
<section class="page-heading"><div><a class="back-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.Task.PropertyId">← @Model.Task.Property.Name</a><p class="eyebrow">Maintenance task</p><h1>@Model.Task.Title</h1><p>@Model.Task.Property.Name@(Model.Task.Appliance is null ? "" : " · " + Model.Task.Appliance.Name) · <strong>@Model.CurrentRole</strong></p></div></section>
<section class="maintenance-hero panel"><div class="maintenance-card-icon">↻</div><div class="maintenance-hero-main"><p class="eyebrow">@(Model.Task.IsActive ? "Next reminder" : "Task completed")</p><h2>@(Model.Task.IsActive ? Model.Task.NextDueDate.ToString("MMMM d, yyyy") : "No further reminders")</h2><p>@Model.Task.Frequency@(Model.Task.Frequency == MaintenanceFrequency.Custom ? " every " + Model.Task.CustomIntervalDays + " days" : "")@(overdue ? " · Overdue" : "")</p></div><div class="task-status @(overdue ? "task-status-overdue" : Model.Task.IsActive ? "task-status-active" : "task-status-done")">@(overdue ? "Overdue" : Model.Task.IsActive ? "Active" : "Completed")</div></section>
<div class="maintenance-detail-grid"><section class="panel"><p class="eyebrow">Task details</p><h2>Instructions</h2><p class="maintenance-description">@(Model.Task.Description ?? "No instructions added.")</p><div class="completion-history"><div class="panel-heading"><div><p class="eyebrow">History</p><h2>Completions</h2></div><span class="panel-mark">@Model.Task.Completions.Count</span></div>@if (Model.Task.Completions.Count == 0) { <p class="muted-copy">No completion records yet.</p> } else { @foreach (var completion in Model.Task.Completions.OrderByDescending(x => x.CompletedAtUtc)) { <article class="completion-card"><div><b>@completion.CompletedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</b><small>@completion.CompletedByUser.FullName</small></div>@if (!string.IsNullOrWhiteSpace(completion.Notes)) { <p>@completion.Notes</p> }@foreach (var expense in completion.Expenses) { <span class="expense-chip">@expense.Amount.ToString("C") @(string.IsNullOrWhiteSpace(expense.Vendor) ? "expense" : "· " + expense.Vendor)</span> }</article> } }</div></section><section class="panel"><p class="eyebrow">Record completion</p><h2>Mark as done</h2>@if (canEdit && Model.Task.IsActive) { <form class="completion-form" asp-action="Complete" method="post"><input asp-for="Completion.MaintenanceTaskId" type="hidden" /><label asp-for="Completion.Notes"></label><textarea asp-for="Completion.Notes" rows="4" placeholder="What was done?"></textarea><div class="form-two-col"><div><label asp-for="Completion.ExpenseAmount"></label><input asp-for="Completion.ExpenseAmount" type="number" step="0.01" min="0" placeholder="0.00" /></div><div><label asp-for="Completion.Vendor"></label><input asp-for="Completion.Vendor" placeholder="Vendor (optional)" /></div></div><label asp-for="Completion.ExpenseDescription"></label><input asp-for="Completion.ExpenseDescription" placeholder="Expense description (optional)" /><button class="primary-button" type="submit">Record completion</button></form> } else { <p class="muted-copy">@(Model.Task.IsActive ? "Viewers can review this task but cannot record completion." : "This one-time task has been completed.")</p> }</section></div>
