@model HomeCarePH.Models.CreateMaintenanceViewModel
@using HomeCarePH.Domain.Entities
@{ ViewData["Title"] = "Add maintenance task"; }
<div class="form-page"><a class="back-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId">← Property</a><div class="form-card wide-form"><p class="eyebrow">Maintenance schedule</p><h1>Add a task</h1><p class="auth-subtitle">Create a one-time or recurring reminder for property upkeep.</p><form asp-action="Create" method="post"><input asp-for="PropertyId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Title"></label><input asp-for="Title" placeholder="e.g. Replace HVAC filter" autofocus /><span asp-validation-for="Title"></span><div class="form-two-col"><div><label asp-for="ApplianceId"></label><select asp-for="ApplianceId"><option value="">Property-level task</option>@foreach (var appliance in Model.Appliances) { <option value="@appliance.Id">@appliance.Name</option> }</select></div><div><label asp-for="Frequency"></label><select asp-for="Frequency" asp-items="Html.GetEnumSelectList<MaintenanceFrequency>()"></select></div><div><label asp-for="NextDueDate"></label><input asp-for="NextDueDate" type="date" /></div><div><label asp-for="CustomIntervalDays"></label><input asp-for="CustomIntervalDays" type="number" min="1" max="3650" placeholder="Only for Custom" /></div></div><label asp-for="Description"></label><textarea asp-for="Description" rows="4" placeholder="Add instructions or service details"></textarea><div class="form-actions"><a class="secondary-button button-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId">Cancel</a><button class="primary-button" type="submit">Save schedule</button></div></form></div></div>
