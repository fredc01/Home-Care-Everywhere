@model IReadOnlyList<HomeCarePH.Models.MaintenanceListItemViewModel>
@using HomeCarePH.Domain.Entities
@{ ViewData["Title"] = "Maintenance"; var propertyId = ViewData["PropertyId"] as int?; var today = DateOnly.FromDateTime(DateTime.UtcNow); }
<section class="page-heading"><div><p class="eyebrow">Care and upkeep</p><h1>Maintenance schedule</h1><p>Recurring tasks, upcoming reminders, completion history, and expenses.</p></div>@if (propertyId.HasValue) { <a class="primary-button button-link" asp-action="Create" asp-route-propertyId="@propertyId">+ Add task</a> }</section>
@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon">↻</div><h2>No maintenance tasks yet</h2><p>Open a property workspace to add a recurring maintenance schedule.</p><a class="primary-button button-link" asp-controller="Properties" asp-action="Index">View properties</a></div> } else { <div class="reminder-banner"><span class="reminder-icon">!</span><span><b>Upcoming reminders</b><small>@Model.Count(x => x.IsActive && x.NextDueDate <= today.AddDays(30)) task@(Model.Count(x => x.IsActive && x.NextDueDate <= today.AddDays(30)) == 1 ? "" : "s") due in the next 30 days</small></span></div><div class="maintenance-list">@foreach (var task in Model) { var overdue = task.IsActive && task.NextDueDate < today; var dueSoon = task.IsActive && !overdue && task.NextDueDate <= today.AddDays(30); <a class="maintenance-card @(overdue ? "maintenance-overdue" : dueSoon ? "maintenance-due" : "")" asp-action="Details" asp-route-id="@task.Id"><div class="maintenance-card-icon">↻</div><div class="maintenance-card-main"><h2>@task.Title</h2><p>@task.PropertyName@(task.ApplianceName is null ? "" : " · " + task.ApplianceName)</p><div class="maintenance-card-meta"><span>@task.Frequency@(task.Frequency == MaintenanceFrequency.Custom ? " recurring" : "")</span><span>@task.CompletionCount completions</span></div></div><div class="due-date"><small>@(task.IsActive ? (overdue ? "Overdue" : dueSoon ? "Due soon" : "Next due") : "Completed")</small><b>@(task.IsActive ? task.NextDueDate.ToString("MMM d, yyyy") : "—")</b></div></a> }</div> }
