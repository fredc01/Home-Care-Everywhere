@model HomeCarePH.Models.CaregiverListViewModel
@{ ViewData["Title"] = "Care team"; }
<section class="page-heading"><div><p class="eyebrow">Care coordination / people</p><h1>Care team</h1><p>Manage independent caregiver profiles, assignments, and visit coverage.</p></div><a class="primary-button" asp-action="Create">Add caregiver</a></section>
<form class="resident-filters" method="get"><div><label for="search">Search caregivers</label><input id="search" name="search" value="@Model.Search" placeholder="Name, role, or specialization" /></div><label class="filter-check"><input type="checkbox" name="includeInactive" value="true" checked="@Model.IncludeInactive" /> Include inactive</label><button class="secondary-button" type="submit">Filter</button></form>
@if (Model.Caregivers.Count == 0) { <section class="empty-state"><div class="empty-icon">✦</div><h2>No caregivers found</h2><p>Add a caregiver and assign them to an authorized household.</p><a class="primary-button" asp-action="Create">Add caregiver</a></section> } else { <section class="caregiver-grid">@foreach (var caregiver in Model.Caregivers) { <a class="caregiver-card @(caregiver.IsActive ? "" : "caregiver-card-inactive")" asp-action="Details" asp-route-id="@caregiver.Id"><div class="caregiver-card-top"><span class="caregiver-avatar">@caregiver.FullName.Substring(0, 1).ToUpperInvariant()</span><span class="caregiver-status">@(caregiver.IsActive ? "Active" : "Inactive")</span></div><h2>@caregiver.FullName</h2><p>@(caregiver.Role ?? "Caregiver")</p><div class="caregiver-card-meta"><span>@caregiver.AssignmentCount assignments</span><span>@caregiver.VisitCount visits</span></div>@if (caregiver.NextVisitUtc.HasValue) { <small class="caregiver-next-visit">Next visit · @caregiver.NextVisitUtc.Value.ToLocalTime().ToString("MMM d · h:mm tt")</small> }</a> }</section><nav class="resident-pagination" aria-label="Care team pages">@for (var p = 1; p <= Model.PageCount; p++) { <a class="@(p == Model.Page ? "current" : "")" asp-action="Index" asp-route-search="@Model.Search" asp-route-includeInactive="@Model.IncludeInactive" asp-route-page="@p">@p</a> }</nav> }
