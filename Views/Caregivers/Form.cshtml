@model HomeCarePH.Models.CaregiverFormViewModel
@{ var isEdit = Model.Id.HasValue; ViewData["Title"] = isEdit ? "Edit caregiver" : "Add caregiver"; }
<section class="form-page caregiver-form-page"><a class="back-link" asp-action="Index">← Back to care team</a><div class="form-card"><p class="eyebrow">Independent caregiver profile</p><h1>@ViewData["Title"]</h1><p class="auth-subtitle">This profile is separate from household membership and platform sign-in permissions.</p><form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-section"><h2>Profile and contact</h2><div class="form-two-col"><div><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName"></span></div><div><label asp-for="Role"></label><input asp-for="Role" placeholder="Nurse, aide, therapist" /></div></div><div class="form-two-col"><div><label asp-for="Email"></label><input asp-for="Email" type="email" /></div><div><label asp-for="ContactNumber"></label><input asp-for="ContactNumber" /></div></div></div><div class="form-section"><h2>Skills and availability</h2><div><label asp-for="Skills"></label><textarea asp-for="Skills" rows="3" placeholder="Medication support, mobility assistance, wound care"></textarea></div><div><label asp-for="Qualifications"></label><textarea asp-for="Qualifications" rows="3" placeholder="Licenses, certifications, training"></textarea></div><div><label asp-for="Specializations"></label><textarea asp-for="Specializations" rows="3" placeholder="Dementia care, post-operative support"></textarea></div><div><label asp-for="Availability"></label><textarea asp-for="Availability" rows="3" placeholder="Mon–Fri, 8:00 AM–5:00 PM; weekends by request"></textarea></div><div><label asp-for="Notes"></label><textarea asp-for="Notes" rows="3"></textarea></div></div><div class="form-section"><h2>@(isEdit ? "Profile assignment context" : "Initial assignment")</h2><div><label asp-for="HouseholdId"></label><select asp-for="HouseholdId"><option value="">Select household</option>@foreach (var household in Model.Households) { <option value="@household.Id">@household.Name</option> }</select></div><div><label asp-for="ResidentId">Resident (optional)</label><select asp-for="ResidentId"><option value="">Whole household</option>@foreach (var resident in Model.Residents) { <option value="@resident.Id">@resident.Name</option> }</select></div></div>@if (isEdit) { <label class="checkbox-row"><input asp-for="IsActive" /> Keep caregiver active</label> }<div class="form-actions"><a class="secondary-button" asp-action="Index">Cancel</a><button class="primary-button" type="submit">@(isEdit ? "Save changes" : "Create caregiver")</button></div></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
