@model HomeCarePH.Models.CaregiverDetailsViewModel
@{ ViewData["Title"] = Model.Caregiver.FullName; }
<section class="caregiver-profile-heading"><div class="caregiver-avatar large-caregiver-avatar">@Model.Caregiver.FullName.Substring(0, 1).ToUpperInvariant()</div><div><p class="eyebrow">Care team profile</p><h1>@Model.Caregiver.FullName</h1><p>@(Model.Caregiver.Role ?? "Caregiver") <span>·</span> <span class="caregiver-status">@(Model.Caregiver.IsActive ? "Active" : "Inactive")</span></p></div><a class="secondary-button" asp-action="Edit" asp-route-id="@Model.Caregiver.Id">Edit profile</a></section>
<section class="caregiver-detail-grid"><article class="panel"><p class="eyebrow">Profile details</p><h2>Skills and availability</h2><div class="info-list"><div><span>Email</span><b>@(Model.Caregiver.Email ?? "Not provided")</b></div><div><span>Phone</span><b>@(Model.Caregiver.ContactNumber ?? "Not provided")</b></div><div><span>Skills</span><b>@(Model.Caregiver.Skills ?? "Not recorded")</b></div><div><span>Qualifications</span><b>@(Model.Caregiver.Qualifications ?? "Not recorded")</b></div><div><span>Specializations</span><b>@(Model.Caregiver.Specializations ?? "Not recorded")</b></div><div><span>Availability</span><b>@(Model.Caregiver.Availability ?? "Not recorded")</b></div></div>@if (!string.IsNullOrWhiteSpace(Model.Caregiver.Notes)) { <div class="care-note"><b>Notes</b><p>@Model.Caregiver.Notes</p></div> }</article><article class="panel"><div class="panel-heading"><div><p class="eyebrow">Coverage</p><h2>Assignments</h2></div><span class="panel-count">@Model.Assignments.Count(x => x.IsActive)</span></div><div class="assignment-list">@if (Model.Assignments.Count == 0) { <p class="empty-inline">No assignments yet.</p> } else { @foreach (var assignment in Model.Assignments) { <div class="assignment-row @(assignment.IsActive ? "" : "assignment-ended")"><span class="list-icon">@(assignment.Resident == null ? "⌂" : "♥")</span><span class="list-main"><b>@(assignment.Resident?.FullName ?? assignment.Household.Name)</b><small>@assignment.Household.Name · @(assignment.IsActive ? "Active assignment" : "Ended")</small></span>@if (assignment.IsActive) { <form asp-action="EndAssignment" asp-route-id="@assignment.Id" method="post"><button class="link-button danger-button" type="submit">End</button></form> }</div> } }</div><form class="assignment-form" asp-action="Assign" method="post"><input type="hidden" name="CaregiverId" value="@Model.Caregiver.Id" /><label for="assignmentHousehold">Add assignment</label><select id="assignmentHousehold" name="HouseholdId"><option value="">Select household</option>@foreach (var household in Model.Households) { <option value="@household.Id">@household.Name</option> }</select><select name="ResidentId"><option value="">Whole household</option>@foreach (var resident in Model.Residents) { <option value="@resident.Id">@resident.Name</option> }</select><input name="Notes" placeholder="Assignment note (optional)" /><button class="secondary-button" type="submit">Assign caregiver</button></form></article></section>
<section class="caregiver-visits-grid"><article class="panel"><div class="panel-heading"><div><p class="eyebrow">Next on the calendar</p><h2>Upcoming visits</h2></div><span class="panel-count">@Model.UpcomingVisits.Count</span></div><div class="visit-history-list">@if (Model.UpcomingVisits.Count == 0) { <p class="empty-inline">No upcoming visits.</p> } else { @foreach (var visit in Model.UpcomingVisits) { <div class="visit-history-row"><span class="visit-date">@visit.ScheduledAtUtc.ToLocalTime().ToString("MMM d")<small>@visit.ScheduledAtUtc.ToLocalTime().ToString("h:mm tt")</small></span><span class="list-main"><b>@visit.Resident.FullName</b><small>@visit.Resident.Household.Name</small></span><span class="task-status task-status-active">@visit.Status</span></div> } }</div></article><article class="panel"><div class="panel-heading"><div><p class="eyebrow">Completed and past</p><h2>Previous visits</h2></div><span class="panel-count">@Model.PreviousVisits.Count</span></div><div class="visit-history-list">@if (Model.PreviousVisits.Count == 0) { <p class="empty-inline">No previous visits.</p> } else { @foreach (var visit in Model.PreviousVisits) { <div class="visit-history-row"><span class="visit-date">@visit.ScheduledAtUtc.ToLocalTime().ToString("MMM d")<small>@visit.ScheduledAtUtc.ToLocalTime().ToString("h:mm tt")</small></span><span class="list-main"><b>@visit.Resident.FullName</b><small>@visit.Resident.Household.Name</small></span><span class="task-status task-status-done">@visit.Status</span></div> } }</div></article></section>
