<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · HomeCarePH</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">+</span><span>HomeCare<span class="brand-accent">PH</span></span></a>
            <p class="nav-caption">Workspace</p>
            <nav class="side-nav" aria-label="Primary navigation">
                <a class="nav-link active" asp-controller="Home" asp-action="Index"><span>▦</span> Dashboard</a>
                <a class="nav-link" href="#households"><span>⌂</span> Households <span class="nav-soon">Soon</span></a>
                <a class="nav-link" href="#residents"><span>♥</span> Residents <span class="nav-soon">Soon</span></a>
                <a class="nav-link" href="#care-team"><span>✦</span> Care team <span class="nav-soon">Soon</span></a>
            </nav>
            <div class="sidebar-footer"><div class="avatar">HC</div><div><b>HomeCarePH</b><small>Operations workspace</small></div></div>
        </aside>
        <main class="main-content">
            <header class="topbar"><span class="topbar-label">Care coordination platform</span><a asp-controller="Home" asp-action="Privacy">Privacy</a></header>
            <div class="content-wrap">@RenderBody()</div>
            <footer class="app-footer">HomeCarePH <span>·</span> Foundation workspace</footer>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
