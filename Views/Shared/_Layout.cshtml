<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · HomeCarePH</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/care-team.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/care-visits.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">+</span><span>HomeCare<span class="brand-accent">PH</span></span></a>
            <p class="nav-caption">Workspace</p>
            <nav class="side-nav" aria-label="Primary navigation">
                <a class="nav-link active" asp-controller="Home" asp-action="Index"><span>▦</span> Dashboard</a>
                <a class="nav-link" asp-controller="Households" asp-action="Index"><span>⌂</span> Households</a>
                <a class="nav-link" asp-controller="Marketplace" asp-action="Repairs"><span>⚒</span> Repairs</a>
                <a class="nav-link" asp-controller="Marketplace" asp-action="Providers"><span>♧</span> Providers</a>
                <a class="nav-link" asp-controller="Residents" asp-action="Index"><span>♥</span> Residents</a>
                <a class="nav-link" asp-controller="Caregivers" asp-action="Index"><span>✦</span> Care team</a>
                <a class="nav-link" asp-controller="CareVisits" asp-action="Index"><span>↗</span> Visits</a>
            </nav>
            <div class="sidebar-footer"><div class="avatar">HC</div><div><b>HomeCarePH</b><small>Operations workspace</small></div></div>
        </aside>
        <main class="main-content">
            <header class="topbar"><span class="topbar-label">Care coordination platform</span><div class="topbar-actions"><a asp-controller="Home" asp-action="Privacy">Privacy</a>@if (User.Identity?.IsAuthenticated == true) { <a asp-controller="Profile" asp-action="Index">Profile</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button" type="submit">Sign out</button></form> } else { <a asp-controller="Account" asp-action="Login">Sign in</a><a class="topbar-cta" asp-controller="Account" asp-action="Register">Create account</a> }</div></header>
            <div class="content-wrap">@RenderBody()</div>
            <footer class="app-footer">HomeCarePH <span>·</span> Foundation workspace</footer>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
