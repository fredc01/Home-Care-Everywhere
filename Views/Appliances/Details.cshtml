@model HomeCarePH.Models.ApplianceDetailsViewModel
@using HomeCarePH.Domain.Entities
@{ ViewData["Title"] = Model.Appliance.Name; var canEdit = Model.CurrentRole is HouseholdRole.Owner or HouseholdRole.Admin or HouseholdRole.Member; var warrantyActive = Model.Appliance.WarrantyEndDate.HasValue && Model.Appliance.WarrantyEndDate.Value >= DateOnly.FromDateTime(DateTime.UtcNow); }
<section class="page-heading"><div><a class="back-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.Appliance.PropertyId">← @Model.Appliance.Property.Name</a><p class="eyebrow">Appliance inventory</p><h1>@Model.Appliance.Name</h1><p>@(Model.Appliance.Brand ?? "Brand not added")@(string.IsNullOrWhiteSpace(Model.Appliance.ModelNumber) ? "" : " · " + Model.Appliance.ModelNumber) · <strong>@Model.CurrentRole</strong></p></div></section>
@if (TempData["ApplianceMessage"] is string message) { <div class="notice">@message</div> }
<section class="appliance-overview panel"><div class="appliance-large-icon">▣</div><div class="appliance-overview-main"><p class="eyebrow">Product details</p><h2>@Model.Appliance.Name</h2><div class="detail-facts"><span><small>Brand</small><b>@(Model.Appliance.Brand ?? "—")</b></span><span><small>Model</small><b>@(Model.Appliance.ModelNumber ?? "—")</b></span><span><small>Serial number</small><b>@(Model.Appliance.SerialNumber ?? "—")</b></span></div></div><div class="warranty-status @(warrantyActive ? "warranty-good" : "warranty-expired")"><span>@(warrantyActive ? "Covered" : "Check warranty")</span><b>@(Model.Appliance.WarrantyEndDate?.ToString("MMM d, yyyy") ?? "No end date")</b></div></section>
<div class="appliance-detail-grid"><section class="panel"><p class="eyebrow">Purchase and warranty</p><h2>Dates and coverage</h2><div class="info-list"><div><span>Purchase date</span><b>@(Model.Appliance.PurchaseDate?.ToString("MMM d, yyyy") ?? "Not added")</b></div><div><span>Purchase price</span><b>@(Model.Appliance.PurchasePrice.HasValue ? Model.Appliance.PurchasePrice.Value.ToString("C") : "Not added")</b></div><div><span>Warranty starts</span><b>@(Model.Appliance.WarrantyStartDate?.ToString("MMM d, yyyy") ?? "Not added")</b></div><div><span>Warranty ends</span><b>@(Model.Appliance.WarrantyEndDate?.ToString("MMM d, yyyy") ?? "Not added")</b></div></div>@if (!string.IsNullOrWhiteSpace(Model.Appliance.Notes)) { <div class="appliance-notes"><b>Notes</b><p>@Model.Appliance.Notes</p></div> }</section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Warranty documents</p><h2>Receipts and files</h2></div><span class="panel-mark">@Model.Appliance.Documents.Count</span></div>@if (Model.Appliance.Documents.Count == 0) { <p class="muted-copy">Upload a receipt, warranty document, or manual for quick access.</p> } else { <div class="document-list">@foreach (var document in Model.Appliance.Documents.OrderByDescending(x => x.UploadedAtUtc)) { <a class="document-row" href="@document.StoredPath" target="_blank" rel="noopener"><span class="document-icon">↗</span><span><b>@document.FileName</b><small>@document.DocumentType · @((document.FileSizeBytes / 1024d / 1024d).ToString("0.##")) MB</small></span><span class="card-arrow">→</span></a> }</div> }@if (canEdit) { <form class="document-upload" asp-action="UploadDocument" method="post" enctype="multipart/form-data"><input asp-for="Upload.ApplianceId" type="hidden" /><input asp-for="Upload.Document" accept="application/pdf,image/jpeg,image/png,image/webp,.docx" /><select asp-for="Upload.DocumentType" asp-items="Html.GetEnumSelectList<ApplianceDocumentType>()"></select><button class="secondary-button" type="submit">Upload document</button><small>PDF, JPG, PNG, WebP, or DOCX · max 15 MB</small></form> }</section></div>
