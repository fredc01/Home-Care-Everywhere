@model HomeCarePH.Models.CreateApplianceViewModel
@{ ViewData["Title"] = "Add appliance"; }
<div class="form-page"><a class="back-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId">← Property</a><div class="form-card wide-form"><p class="eyebrow">Appliance inventory</p><h1>Add an appliance</h1><p class="auth-subtitle">Record the details you’ll need when booking service or making a warranty claim.</p><form asp-action="Create" method="post"><input asp-for="PropertyId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Refrigerator" autofocus /><span asp-validation-for="Name"></span><div class="form-two-col"><div><label asp-for="Brand"></label><input asp-for="Brand" placeholder="Brand" /></div><div><label asp-for="ModelNumber"></label><input asp-for="ModelNumber" placeholder="Model or product number" /></div><div><label asp-for="SerialNumber"></label><input asp-for="SerialNumber" placeholder="Serial number" /></div><div><label asp-for="PurchaseDate"></label><input asp-for="PurchaseDate" type="date" /></div><div><label asp-for="PurchasePrice"></label><input asp-for="PurchasePrice" type="number" step="0.01" min="0" placeholder="0.00" /></div><div><label asp-for="WarrantyStartDate"></label><input asp-for="WarrantyStartDate" type="date" /></div><div><label asp-for="WarrantyEndDate"></label><input asp-for="WarrantyEndDate" type="date" /></div></div><label asp-for="Notes"></label><textarea asp-for="Notes" rows="4" placeholder="Add service notes or other context"></textarea><div class="form-actions"><a class="secondary-button button-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId">Cancel</a><button class="primary-button" type="submit">Save appliance</button></div></form></div></div>
