@model IReadOnlyList<HomeCarePH.Models.ApplianceListItemViewModel>
@{ ViewData["Title"] = "Appliances"; var propertyId = Model.FirstOrDefault()?.PropertyId ?? 0; }
<section class="page-heading"><div><a class="back-link" asp-controller="Properties" asp-action="Index" asp-route-householdId="@ViewData["HouseholdId"]">← Properties</a><p class="eyebrow">@ViewData["PropertyName"]</p><h1>Appliances</h1><p>Track serial numbers, purchase information, warranties, and documents.</p></div>@if (propertyId > 0) { <a class="primary-button button-link" asp-action="Create" asp-route-propertyId="@propertyId">+ Add appliance</a> }</section>
@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon">▣</div><h2>No appliances yet</h2><p>Add the first appliance to start tracking its warranty and receipts.</p><a class="primary-button button-link" asp-action="Create" asp-route-propertyId="@propertyId">Add appliance</a></div> } else { <div class="appliance-grid">@foreach (var appliance in Model) { <a class="appliance-card" asp-action="Details" asp-route-id="@appliance.Id"><div class="appliance-card-top"><span class="appliance-icon">▣</span><span class="card-arrow">→</span></div><h2>@appliance.Name</h2><p>@(appliance.Brand ?? "Brand not added")@(string.IsNullOrWhiteSpace(appliance.ModelNumber) ? "" : " · " + appliance.ModelNumber)</p><div class="appliance-meta"><span>SN @(appliance.SerialNumber ?? "Not added")</span><span>@appliance.DocumentCount documents</span></div>@if (appliance.WarrantyEndDate.HasValue) { <div class="warranty-chip @(appliance.WarrantyEndDate.Value < DateOnly.FromDateTime(DateTime.UtcNow) ? "warranty-expired" : "")">Warranty @(appliance.WarrantyEndDate.Value < DateOnly.FromDateTime(DateTime.UtcNow) ? "expired" : "until " + appliance.WarrantyEndDate.Value.ToString("MMM yyyy"))</div> } else { <div class="warranty-chip warranty-missing">Warranty dates not added</div> }</a> }</div> }
