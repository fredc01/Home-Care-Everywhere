@model HomeCarePH.Models.CreatePropertyViewModel
@{ ViewData["Title"] = "New property"; }
<div class="form-page"><a class="back-link" asp-action="Index" asp-route-householdId="@Model.HouseholdId">← Properties</a><div class="form-card wide-form"><p class="eyebrow">Property management</p><h1>Add a property</h1><p class="auth-subtitle">Capture the location and context your household team needs to coordinate care.</p><form asp-action="Create" method="post"><input asp-for="HouseholdId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Main residence" autofocus /><span asp-validation-for="Name"></span><div class="form-two-col"><div><label asp-for="PropertyType"></label><input asp-for="PropertyType" placeholder="Home, apartment, cottage" /></div><div><label asp-for="AddressLine1"></label><input asp-for="AddressLine1" placeholder="Street address" /></div><div><label asp-for="City"></label><input asp-for="City" placeholder="City" /></div><div><label asp-for="Province"></label><input asp-for="Province" placeholder="Province / state" /></div><div><label asp-for="PostalCode"></label><input asp-for="PostalCode" placeholder="Postal code" /></div></div><label asp-for="Description"></label><textarea asp-for="Description" rows="4" placeholder="Add a short description or access context"></textarea><div class="form-actions"><a class="secondary-button button-link" asp-action="Index" asp-route-householdId="@Model.HouseholdId">Cancel</a><button class="primary-button" type="submit">Create property</button></div></form></div></div>
