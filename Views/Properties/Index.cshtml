@model IReadOnlyList<HomeCarePH.Models.PropertyListItemViewModel>
@{ ViewData["Title"] = "Properties"; }
<section class="page-heading"><div><p class="eyebrow">Places and spaces</p><h1>Properties</h1><p>Keep property details, rooms, photos, and records together.</p></div></section>
@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon">⌂</div><h2>No properties yet</h2><p>Open a household workspace to create the first property.</p><a class="primary-button button-link" asp-controller="Households" asp-action="Index">View households</a></div> } else { <div class="property-grid">@foreach (var property in Model) { <a class="property-card" asp-action="Details" asp-route-id="@property.Id"><div class="property-card-top"><span class="property-icon">⌂</span><span class="card-arrow">→</span></div><h2>@property.Name</h2><p class="property-household">@property.HouseholdName</p><p class="property-location">@(property.City ?? "Location not added")</p><div class="property-stats"><span>@property.RoomCount rooms</span><span>@property.PhotoCount photos</span></div></a> }</div> }
