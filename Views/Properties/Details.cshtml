@model HomeCarePH.Models.PropertyDetailsViewModel
@using HomeCarePH.Domain.Entities
@{ ViewData["Title"] = Model.Property.Name; var canEdit = Model.CurrentRole is HouseholdRole.Owner or HouseholdRole.Admin or HouseholdRole.Member; }
<section class="page-heading"><div><a class="back-link" asp-action="Index" asp-route-householdId="@Model.Property.HouseholdId">← Properties</a><p class="eyebrow">@Model.Property.Household.Name</p><h1>@Model.Property.Name</h1><p>@(Model.Property.PropertyType ?? "Property") · @(Model.Property.City ?? "Location not added") · <strong>@Model.CurrentRole</strong></p></div></section>
@if (TempData["PropertyMessage"] is string message) { <div class="notice">@message</div> }
<section class="property-overview panel"><div><p class="eyebrow">Property details</p><h2>@(Model.Property.AddressLine1 ?? "Address not added")</h2><p>@Model.Property.Description</p></div><div class="overview-facts"><span><b>@Model.Property.Rooms.Count</b> rooms</span><span><b>@Model.Property.Photos.Count</b> photos</span><span><b>@Model.Property.Records.Count</b> records</span></div></section>
<section class="panel appliance-summary"><div class="panel-heading"><div><p class="eyebrow">Appliance inventory</p><h2>Keep warranties within reach</h2></div><div class="heading-actions"><span class="panel-mark">@Model.Property.Appliances.Count</span><a class="secondary-button button-link" asp-controller="Appliances" asp-action="Index" asp-route-propertyId="@Model.Property.Id">View inventory</a>@if (canEdit) { <a class="secondary-button button-link" asp-controller="Appliances" asp-action="Create" asp-route-propertyId="@Model.Property.Id">+ Add appliance</a> }</div></div>@if (Model.Property.Appliances.Count == 0) { <p class="muted-copy">No appliances have been added to this property yet.</p> } else { <div class="appliance-mini-grid">@foreach (var appliance in Model.Property.Appliances.OrderBy(x => x.Name)) { <a class="appliance-mini-card" asp-controller="Appliances" asp-action="Details" asp-route-id="@appliance.Id"><span class="appliance-icon">▣</span><span><b>@appliance.Name</b><small>@(appliance.Brand ?? "Brand not added")@(string.IsNullOrWhiteSpace(appliance.ModelNumber) ? "" : " · " + appliance.ModelNumber)</small></span><span class="card-arrow">→</span></a> }</div> }</section>
<section class="panel maintenance-summary"><div class="panel-heading"><div><p class="eyebrow">Maintenance</p><h2>Stay ahead of upkeep</h2></div><div class="heading-actions"><span class="panel-mark">@Model.Property.MaintenanceTasks.Count</span><a class="secondary-button button-link" asp-controller="Maintenance" asp-action="Index" asp-route-propertyId="@Model.Property.Id">View schedule</a>@if (canEdit) { <a class="secondary-button button-link" asp-controller="Maintenance" asp-action="Create" asp-route-propertyId="@Model.Property.Id">+ Add task</a> }</div></div>@if (Model.Property.MaintenanceTasks.Count == 0) { <p class="muted-copy">No maintenance schedules have been added to this property yet.</p> } else { <div class="maintenance-mini-list">@foreach (var task in Model.Property.MaintenanceTasks.Where(x => x.IsActive).OrderBy(x => x.NextDueDate).Take(4)) { <a class="maintenance-mini-row" asp-controller="Maintenance" asp-action="Details" asp-route-id="@task.Id"><span class="maintenance-icon">↻</span><span><b>@task.Title</b><small>Due @task.NextDueDate.ToString("MMM d, yyyy")</small></span><span class="card-arrow">→</span></a> }</div> }</section>
<div class="property-detail-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Rooms and spaces</p><h2>Inside this property</h2></div><span class="panel-mark">@Model.Property.Rooms.Count</span></div>@if (Model.Property.Rooms.Count == 0) { <p class="muted-copy">No rooms have been added yet.</p> } else { <div class="room-list">@foreach (var room in Model.Property.Rooms.OrderBy(x => x.Name)) { <div class="room-row"><span class="room-icon">⌂</span><div><b>@room.Name</b><small>@(room.SpaceType ?? "Space")@(string.IsNullOrWhiteSpace(room.Description) ? "" : " · " + room.Description)</small></div></div> }</div> }@if (canEdit) { <form class="compact-form" asp-action="AddRoom" method="post"><input asp-for="Room.PropertyId" type="hidden" /><div class="form-two-col"><input asp-for="Room.Name" placeholder="Room name" /><input asp-for="Room.SpaceType" placeholder="Type (bedroom, kitchen...)" /></div><input asp-for="Room.Description" placeholder="Optional description" /><button class="secondary-button" type="submit">+ Add room</button></form> }</section>
<section class="panel"><div class="panel-heading"><div><p class="eyebrow">Property records</p><h2>Notes and history</h2></div><span class="panel-mark">@Model.Property.Records.Count</span></div>@if (Model.Property.Records.Count == 0) { <p class="muted-copy">Keep practical notes, maintenance details, and access information here.</p> } else { <div class="record-list">@foreach (var record in Model.Property.Records.OrderByDescending(x => x.RecordedAtUtc)) { <article class="record-card"><div><b>@record.Title</b><span class="role-badge">@(record.RecordType ?? "Note")</span></div><p>@record.Notes</p><small>@record.CreatedByUser.FullName · @record.RecordedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</small></article> }</div> }@if (canEdit) { <form class="compact-form" asp-action="AddRecord" method="post"><input asp-for="Record.PropertyId" type="hidden" /><input asp-for="Record.Title" placeholder="Record title" /><div class="form-two-col"><input asp-for="Record.RecordType" placeholder="Type (maintenance, access...)" /><textarea asp-for="Record.Notes" rows="3" placeholder="Write a note..."></textarea></div><button class="secondary-button" type="submit">+ Add record</button></form> }</section></div>
<section class="panel photo-panel"><div class="panel-heading"><div><p class="eyebrow">Property photos</p><h2>Visual reference</h2></div><span class="panel-mark">@Model.Property.Photos.Count</span></div>@if (Model.Property.Photos.Count > 0) { <div class="photo-grid">@foreach (var photo in Model.Property.Photos) { <figure><img src="@photo.StoredPath" alt="@(photo.Caption ?? photo.FileName)" /><figcaption>@(photo.Caption ?? photo.FileName)</figcaption></figure> }</div> } else { <p class="muted-copy">Add photos to give household members a shared visual reference.</p> }@if (canEdit) { <form class="photo-upload" asp-action="UploadPhoto" method="post" enctype="multipart/form-data"><input asp-for="Upload.PropertyId" type="hidden" /><input asp-for="Upload.Photo" accept="image/jpeg,image/png,image/webp" /><input asp-for="Upload.Caption" placeholder="Caption (optional)" /><button class="secondary-button" type="submit">Upload photo</button><small>JPG, PNG, or WebP · max 10 MB</small></form> }</section>
