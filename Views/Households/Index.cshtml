@model IReadOnlyList<HomeCarePH.Models.HouseholdListItemViewModel>
@{ ViewData["Title"] = "Households"; }
<section class="page-heading"><div><p class="eyebrow">Your care network</p><h1>Households</h1><p>Manage the people and care teams connected to each household.</p></div><a class="primary-button button-link" asp-action="Create">+ New household</a></section>
@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon">⌂</div><h2>Create your first household</h2><p>Households keep resident records, visits, and member permissions together.</p><a class="primary-button button-link" asp-action="Create">Create household</a></div> } else { <div class="household-grid">@foreach (var household in Model) { <a class="household-card" asp-action="Details" asp-route-id="@household.Id"><div class="household-icon">⌂</div><div><h2>@household.Name</h2><p>@household.MemberCount member@(household.MemberCount == 1 ? "" : "s") <span>·</span> @household.Role</p></div><span class="card-arrow">→</span></a> }</div> }
