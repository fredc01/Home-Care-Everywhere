@model HomeCarePH.Models.HouseholdDetailsViewModel
@using HomeCarePH.Domain.Entities
@{ ViewData["Title"] = Model.Household.Name; var canManage = Model.CurrentRole is HouseholdRole.Owner or HouseholdRole.Admin; }
<section class="page-heading"><div><a class="back-link" asp-action="Index">← Households</a><p class="eyebrow">Household workspace</p><h1>@Model.Household.Name</h1><p>You are a <strong>@Model.CurrentRole</strong>. Manage access and membership below.</p></div><div class="heading-actions"><a class="secondary-button button-link" asp-controller="Properties" asp-action="Index" asp-route-householdId="@Model.Household.Id">View properties</a>@if (canManage) { <a class="primary-button button-link" asp-controller="Properties" asp-action="Create" asp-route-householdId="@Model.Household.Id">+ Add property</a> }</div></section>
@if (TempData["HouseholdMessage"] is string message) { <div class="notice">@message</div> }
<div class="household-columns"><section class="panel members-panel"><div class="panel-heading"><div><p class="eyebrow">Access control</p><h2>Members</h2></div><span class="panel-mark">@Model.Members.Count</span></div><div class="member-list">@foreach (var member in Model.Members) { <div class="member-row"><div class="member-avatar">@member.User.FullName.Substring(0, 1).ToUpperInvariant()</div><div class="member-data"><b>@member.User.FullName</b><small>@member.User.Email</small></div><span class="role-badge role-@member.Role.ToString().ToLowerInvariant()">@member.Role</span></div> }</div></section><section class="panel invite-panel"><p class="eyebrow">Bring in your team</p><h2>Invite a member</h2><p>Invitations are valid for seven days and only the invited email can accept them.</p>@if (canManage) { <form asp-action="Invite" method="post"><input asp-for="Invite.HouseholdId" type="hidden" /><label asp-for="Invite.Email">Email address</label><input asp-for="Invite.Email" placeholder="name@example.com" /><span asp-validation-for="Invite.Email"></span><label asp-for="Invite.Role">Household role</label><select asp-for="Invite.Role" asp-items="Html.GetEnumSelectList<HouseholdRole>()"></select><button class="primary-button" type="submit">Create invitation</button></form> } else { <div class="permission-note">Only household owners and admins can invite members.</div> }</section></div>
@if (canManage && Model.PendingInvitations.Count > 0) { <section class="panel pending-panel"><p class="eyebrow">Awaiting acceptance</p><h2>Pending invitations</h2>@foreach (var invitation in Model.PendingInvitations) { <div class="member-row"><div class="member-data"><b>@invitation.Email</b><small>Expires @invitation.ExpiresAtUtc.ToLocalTime().ToString("MMM d, yyyy")</small></div><span class="role-badge">@invitation.Role</span></div> }</section> }
