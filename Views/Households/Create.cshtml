@model HomeCarePH.Models.CreateHouseholdViewModel
@{ ViewData["Title"] = "New household"; }
<div class="form-page"><a class="back-link" asp-action="Index">← Households</a><div class="form-card"><p class="eyebrow">New care network</p><h1>Create a household</h1><p class="auth-subtitle">You’ll become the owner and can invite family members or care coordinators next.</p><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Santos household" autofocus /><span asp-validation-for="Name"></span><div class="form-actions"><a class="secondary-button button-link" asp-action="Index">Cancel</a><button class="primary-button" type="submit">Create household</button></div></form></div></div>
