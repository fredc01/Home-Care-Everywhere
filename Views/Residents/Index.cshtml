@model HomeCarePH.Models.ResidentListViewModel
@{ ViewData["Title"] = "Residents"; }
<section class="page-heading"><div><p class="eyebrow">Care coordination / people</p><h1>Residents</h1><p>Keep resident profiles, care requirements, and visit history in one protected place.</p></div><a class="primary-button" asp-action="Create">Add resident</a></section>
<form class="resident-filters" method="get"><div><label for="search">Search residents</label><input id="search" name="search" value="@Model.Search" placeholder="Name or contact number" /></div><div><label for="householdId">Household</label><select id="householdId" name="householdId"><option value="">All households</option>@foreach (var household in Model.Households) { <option value="@household.Id" selected="@(Model.HouseholdId == household.Id)">@household.Name</option> }</select></div><label class="filter-check"><input type="checkbox" name="includeArchived" value="true" checked="@Model.IncludeArchived" /> Include archived</label><button class="secondary-button" type="submit">Filter</button></form>
@if (Model.Residents.Count == 0) { <section class="empty-state"><div class="empty-icon">♥</div><h2>No residents found</h2><p>Try a different filter or add the first resident to an authorized household.</p><a class="primary-button" asp-action="Create">Add resident</a></section> } else { <section class="resident-grid">@foreach (var resident in Model.Residents) { <a class="resident-card @(resident.IsActive ? "" : "resident-card-archived")" asp-action="Details" asp-route-id="@resident.Id"><div class="resident-card-top"><span class="resident-avatar">@resident.FullName.Substring(0, 1).ToUpperInvariant()</span><span class="resident-status">@(resident.IsActive ? "Active" : "Archived")</span></div><h2>@resident.FullName</h2><p>@resident.HouseholdName</p><div class="resident-card-meta"><span>@(resident.DateOfBirth?.ToString("MMM d, yyyy") ?? "Birth date not set")</span><span>@resident.VisitCount visits</span></div>@if (resident.NextVisitUtc.HasValue) { <small class="resident-next-visit">Next visit · @resident.NextVisitUtc.Value.ToLocalTime().ToString("MMM d · h:mm tt")</small> }</a> }</section> <nav class="resident-pagination" aria-label="Resident pages">@for (var p = 1; p <= Model.PageCount; p++) { <a class="@(p == Model.Page ? "current" : "")" asp-action="Index" asp-route-search="@Model.Search" asp-route-householdId="@Model.HouseholdId" asp-route-includeArchived="@Model.IncludeArchived" asp-route-page="@p">@p</a> }</nav> }
