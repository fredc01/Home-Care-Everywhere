@model HomeCarePH.Models.ResidentFormViewModel
@{ var isEdit = Model.Id.HasValue; ViewData["Title"] = isEdit ? "Edit resident" : "Add resident"; }
<section class="form-page resident-form-page"><a class="back-link" asp-action="Index">← Back to residents</a><div class="form-card"><p class="eyebrow">Resident profile</p><h1>@ViewData["Title"]</h1><p class="auth-subtitle">Care history is retained when a resident is archived. Fields marked required are needed to create the profile.</p><form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-section"><h2>Personal information</h2><div class="form-two-col"><div><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName"></span></div><div><label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" type="date" /><span asp-validation-for="DateOfBirth"></span></div></div><div><label asp-for="ContactNumber"></label><input asp-for="ContactNumber" /><span asp-validation-for="ContactNumber"></span></div><div><label asp-for="HouseholdId"></label><select asp-for="HouseholdId"><option value="">Select household</option>@foreach (var household in Model.Households) { <option value="@household.Id">@household.Name</option> }</select><span asp-validation-for="HouseholdId"></span></div></div><div class="form-section"><h2>Emergency contact</h2><div class="form-two-col"><div><label asp-for="EmergencyContactName"></label><input asp-for="EmergencyContactName" /></div><div><label asp-for="EmergencyContactRelationship"></label><input asp-for="EmergencyContactRelationship" /></div></div><div><label asp-for="EmergencyContactNumber"></label><input asp-for="EmergencyContactNumber" /></div></div><div class="form-section"><h2>Care profile</h2><div><label asp-for="CareRequirements"></label><textarea asp-for="CareRequirements" rows="4" placeholder="Mobility, medication, dietary, or daily support requirements"></textarea><span asp-validation-for="CareRequirements"></span></div><div><label asp-for="CareNotes"></label><textarea asp-for="CareNotes" rows="5" placeholder="Relevant notes for the authorized care team"></textarea><span asp-validation-for="CareNotes"></span></div></div>@if (isEdit) { <label class="checkbox-row"><input asp-for="IsActive" /> Keep this resident active</label> }<div class="form-actions"><a class="secondary-button" asp-action="Index">Cancel</a><button class="primary-button" type="submit">@(isEdit ? "Save changes" : "Create resident")</button></div></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
