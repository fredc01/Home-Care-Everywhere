@model HomeCarePH.Models.ResidentDetailsViewModel
@{ ViewData["Title"] = Model.Resident.FullName; }
<section class="resident-profile-heading"><div class="resident-avatar large-resident-avatar">@Model.Resident.FullName.Substring(0, 1).ToUpperInvariant()</div><div><p class="eyebrow">Resident profile</p><h1>@Model.Resident.FullName</h1><p>@Model.Resident.Household.Name <span>·</span> <span class="resident-status">@(Model.Resident.IsActive ? "Active" : "Archived")</span></p></div><div class="heading-actions"><a class="secondary-button" asp-action="Edit" asp-route-id="@Model.Resident.Id">Edit profile</a>@if (Model.Resident.IsActive) { <form asp-action="Archive" asp-route-id="@Model.Resident.Id" method="post"><button class="secondary-button danger-button" type="submit">Archive</button></form> } else { <form asp-action="Restore" asp-route-id="@Model.Resident.Id" method="post"><button class="primary-button" type="submit">Restore</button></form> }</div></section>
<section class="resident-detail-grid"><article class="panel"><div class="panel-heading"><div><p class="eyebrow">Personal information</p><h2>About @Model.Resident.FullName.Split(' ')[0]</h2></div></div><div class="info-list"><div><span>Contact number</span><b>@(Model.Resident.ContactNumber ?? "Not provided")</b></div><div><span>Date of birth</span><b>@(Model.Resident.DateOfBirth?.ToString("MMMM d, yyyy") ?? "Not provided")</b></div><div><span>Household</span><b>@Model.Resident.Household.Name</b></div><div><span>Profile created</span><b>@Model.Resident.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</b></div></div><div class="resident-subsection"><p class="eyebrow">Emergency contact</p><div class="info-list"><div><span>Name</span><b>@(Model.Resident.EmergencyContactName ?? "Not provided")</b></div><div><span>Relationship</span><b>@(Model.Resident.EmergencyContactRelationship ?? "Not provided")</b></div><div><span>Phone</span><b>@(Model.Resident.EmergencyContactNumber ?? "Not provided")</b></div></div></div></article><article class="panel"><p class="eyebrow">Care profile</p><h2>Requirements and notes</h2><div class="care-note"><b>Care requirements</b><p>@(string.IsNullOrWhiteSpace(Model.Resident.CareRequirements) ? "No care requirements recorded." : Model.Resident.CareRequirements)</p></div><div class="care-note"><b>Care notes</b><p>@(string.IsNullOrWhiteSpace(Model.Resident.CareNotes) ? "No care notes recorded." : Model.Resident.CareNotes)</p></div></article></section>
<section class="panel resident-history-panel"><div class="panel-heading"><div><p class="eyebrow">Continuity of care</p><h2>Visit history</h2></div><span class="panel-count">@Model.CareHistory.Count</span></div>@if (Model.CareHistory.Count == 0) { <p class="empty-inline">No care visits have been recorded for this resident yet.</p> } else { <div class="visit-history-list">@foreach (var visit in Model.CareHistory) { <div class="visit-history-row"><span class="visit-date">@visit.ScheduledAtUtc.ToLocalTime().ToString("MMM d")<small>@visit.ScheduledAtUtc.ToLocalTime().ToString("h:mm tt")</small></span><span class="list-main"><b>@visit.Status</b><small>Caregiver: @visit.Caregiver.FullName</small>@if (!string.IsNullOrWhiteSpace(visit.Notes)) { <small>@visit.Notes</small> }</span><span class="task-status @(visit.Status == CareVisitStatus.Cancelled ? "task-status-overdue" : visit.Status == CareVisitStatus.Completed ? "task-status-done" : "task-status-active")">@visit.Status</span></div> }</div> }</section>
