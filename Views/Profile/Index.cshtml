@model HomeCarePH.Models.ProfileViewModel
@{ ViewData["Title"] = "Profile"; }
<div class="form-page"><div class="form-card"><p class="eyebrow">Your account</p><h1>Profile</h1><p class="auth-subtitle">Keep your contact details current for household invitations and care coordination.</p>@if (TempData["ProfileMessage"] is string message) { <div class="notice">@message</div> }<form asp-action="Index" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" autocomplete="tel" /><span asp-validation-for="PhoneNumber"></span><button class="primary-button" type="submit">Save profile</button></form></div></div>
