@model HomeCarePH.Models.CareVisitDetailsViewModel
@{ ViewData["Title"] = "Care visit"; }
<section class="page-heading"><div><p class="eyebrow">Care visit / details</p><h1>@Model.Visit.Resident.FullName</h1><p>@Model.Visit.Resident.Household.Name · @Model.Visit.Caregiver.FullName</p></div><div class="heading-actions"><span class="task-status @(Model.Visit.Status == CareVisitStatus.Completed ? "task-status-done" : Model.Visit.Status == CareVisitStatus.Cancelled ? "task-status-overdue" : "task-status-active")">@Model.Visit.Status</span><a class="secondary-button" asp-action="Edit" asp-route-id="@Model.Visit.Id">Edit visit</a></div></section>
@if (Model.HasConflict) { <div class="reminder-banner visit-conflict-banner"><span class="reminder-icon">!</span><div><b>Scheduling conflict detected</b><small>This caregiver has another non-cancelled visit during this time. Review the schedule before proceeding.</small></div></div> }
<section class="visit-detail-grid"><article class="panel"><p class="eyebrow">Schedule</p><h2>Visit plan</h2><div class="info-list"><div><span>Resident</span><b>@Model.Visit.Resident.FullName</b></div><div><span>Caregiver</span><b>@Model.Visit.Caregiver.FullName</b></div><div><span>Starts</span><b>@Model.Visit.ScheduledAtUtc.ToLocalTime().ToString("MMMM d, yyyy · h:mm tt")</b></div><div><span>Expected duration</span><b>@Model.Visit.ExpectedDurationMinutes minutes</b></div><div><span>Started</span><b>@(Model.Visit.StartedAtUtc?.ToLocalTime().ToString("MMM d · h:mm tt") ?? "Not started")</b></div><div><span>Completed</span><b>@(Model.Visit.CompletedAtUtc?.ToLocalTime().ToString("MMM d · h:mm tt") ?? "Not completed")</b></div></div></article><article class="panel"><p class="eyebrow">Instructions and notes</p><h2>Care details</h2><div class="care-note"><b>Instructions</b><p>@(Model.Visit.Instructions ?? "No instructions recorded.")</p></div><div class="care-note"><b>Visit notes</b><p>@(Model.Visit.Notes ?? "No visit notes recorded.")</p></div><div class="care-note"><b>Completion details</b><p>@(Model.Visit.CompletionNotes ?? "No completion details recorded.")</p></div></article></section>
