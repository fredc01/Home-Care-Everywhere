@model HomeCarePH.Models.CareVisitListViewModel
@{ ViewData["Title"] = Model.History ? "Visit history" : "Upcoming visits"; }
<section class="page-heading"><div><p class="eyebrow">Care coordination / schedule</p><h1>@(Model.History ? "Visit history" : "Upcoming visits")</h1><p>@(Model.History ? "Review completed and past care visits." : "Keep the care calendar clear and conflict-aware.")</p></div><div class="heading-actions"><a class="secondary-button" asp-action="Index" asp-route-history="@(!Model.History)">@(Model.History ? "Upcoming visits" : "Visit history")</a><a class="primary-button" asp-action="Create">Schedule visit</a></div></section>
@if (Model.Visits.Count == 0) { <section class="empty-state"><div class="empty-icon">↗</div><h2>No visits here</h2><p>@(Model.History ? "Completed or past visits will appear here." : "Schedule a visit for an actively assigned caregiver.")</p><a class="primary-button" asp-action="Create">Schedule visit</a></section> } else { <section class="visit-list">@foreach (var visit in Model.Visits) { <a class="scheduled-visit-card" asp-action="Details" asp-route-id="@visit.Id"><span class="scheduled-visit-date">@visit.ScheduledAtUtc.ToLocalTime().ToString("MMM d")<small>@visit.ScheduledAtUtc.ToLocalTime().ToString("h:mm tt")</small></span><span class="list-main"><b>@visit.ResidentName</b><small>@visit.HouseholdName · @visit.CaregiverName · @visit.ExpectedDurationMinutes min</small></span><span class="task-status @(visit.Status == CareVisitStatus.Completed ? "task-status-done" : visit.Status == CareVisitStatus.Cancelled ? "task-status-overdue" : "task-status-active")">@visit.Status</span>@if (visit.IsConflict) { <span class="task-status task-status-overdue">Conflict</span> }</a> }</section><nav class="resident-pagination" aria-label="Visit pages">@for (var p = 1; p <= Model.PageCount; p++) { <a class="@(p == Model.Page ? "current" : "")" asp-action="Index" asp-route-history="@Model.History" asp-route-page="@p">@p</a> }</nav> }
