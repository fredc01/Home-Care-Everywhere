@model HomeCarePH.Models.CareVisitFormViewModel
@{ var isEdit = Model.Id.HasValue; ViewData["Title"] = isEdit ? "Edit visit" : "Schedule visit"; }
<section class="form-page visit-form-page"><a class="back-link" asp-action="Index">← Back to visits</a><div class="form-card"><p class="eyebrow">Care visit</p><h1>@ViewData["Title"]</h1><p class="auth-subtitle">Only active caregivers assigned to the resident or their household can be scheduled.</p><form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-section"><h2>Who and when</h2><div><label asp-for="ResidentId"></label><select asp-for="ResidentId"><option value="">Select resident</option>@foreach (var resident in Model.Residents) { <option value="@resident.Id">@resident.Name · @resident.HouseholdName</option> }</select><span asp-validation-for="ResidentId"></span></div><div><label asp-for="CaregiverId"></label><select asp-for="CaregiverId"><option value="">Select assigned caregiver</option>@foreach (var caregiver in Model.Caregivers) { <option value="@caregiver.Id">@caregiver.Name@(string.IsNullOrWhiteSpace(caregiver.Role) ? "" : " · " + caregiver.Role)</option> }</select><span asp-validation-for="CaregiverId"></span></div><div class="form-two-col"><div><label asp-for="ScheduledAtLocal"></label><input asp-for="ScheduledAtLocal" type="datetime-local" /><span asp-validation-for="ScheduledAtLocal"></span></div><div><label asp-for="ExpectedDurationMinutes"></label><input asp-for="ExpectedDurationMinutes" type="number" min="15" max="1440" step="15" /><span asp-validation-for="ExpectedDurationMinutes"></span></div></div></div><div class="form-section"><h2>Status and instructions</h2><div><label asp-for="Status"></label><select asp-for="Status"><option value="Scheduled">Scheduled</option><option value="InProgress">In progress</option><option value="Completed">Completed</option><option value="Cancelled">Cancelled</option></select></div><div><label asp-for="Instructions"></label><textarea asp-for="Instructions" rows="4" placeholder="What the caregiver should know before the visit"></textarea></div><div><label asp-for="Notes"></label><textarea asp-for="Notes" rows="3"></textarea></div><div><label asp-for="CompletionNotes"></label><textarea asp-for="CompletionNotes" rows="4" placeholder="Record outcomes or completion details"></textarea></div></div><div class="form-actions"><a class="secondary-button" asp-action="Index">Cancel</a><button class="primary-button" type="submit">@(isEdit ? "Save visit" : "Schedule visit")</button></div></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
