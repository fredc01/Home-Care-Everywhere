@model IReadOnlyList<HomeCarePH.Models.RepairListItemViewModel>
@using HomeCarePH.Domain.Entities
@{ ViewData["Title"] = "Repair requests"; var propertyId = ViewData["PropertyId"] as int?; }
<section class="page-heading"><div><p class="eyebrow">Repair marketplace</p><h1>Repair requests</h1><p>Track open issues, compare quotations, and manage service bookings.</p></div>@if (propertyId.HasValue) { <a class="primary-button button-link" asp-action="CreateRepair" asp-route-propertyId="@propertyId">+ Request repair</a> }</section>
@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon">⚒</div><h2>No repair requests yet</h2><p>Open a property workspace to request help from a service provider.</p><a class="primary-button button-link" asp-controller="Properties" asp-action="Index">View properties</a></div> } else { <div class="repair-list">@foreach (var repair in Model) { <a class="repair-card" asp-action="RepairDetails" asp-route-id="@repair.Id"><span class="repair-icon">⚒</span><span class="repair-main"><b>@repair.Title</b><small>@repair.PropertyName · @repair.Status · @repair.QuotationCount quotation@(repair.QuotationCount == 1 ? "" : "s")</small></span><span class="priority-badge priority-@repair.Priority.ToString().ToLowerInvariant()">@repair.Priority</span><span class="card-arrow">→</span></a> }</div> }
