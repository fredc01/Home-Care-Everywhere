@model HomeCarePH.Models.CreateRepairRequestViewModel
@using HomeCarePH.Domain.Entities
@{ ViewData["Title"] = "Request repair"; }
<div class="form-page"><a class="back-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId">← Property</a><div class="form-card wide-form"><p class="eyebrow">Repair marketplace</p><h1>Request a repair</h1><p class="auth-subtitle">Describe the issue so service providers can respond with useful quotations.</p><form asp-action="CreateRepair" method="post"><input asp-for="PropertyId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Title"></label><input asp-for="Title" placeholder="e.g. Refrigerator is not cooling" autofocus /><div class="form-two-col"><div><label asp-for="ApplianceId"></label><select asp-for="ApplianceId"><option value="">Property-level repair</option>@foreach (var appliance in Model.Appliances) { <option value="@appliance.Id">@appliance.Name</option> }</select></div><div><label asp-for="Priority"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<RepairRequestPriority>()"></select></div><div><label asp-for="PreferredDate"></label><input asp-for="PreferredDate" type="date" /></div></div><label asp-for="Description"></label><textarea asp-for="Description" rows="6" placeholder="What happened? Include any error codes, sounds, or access details."></textarea><div class="form-actions"><a class="secondary-button button-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId">Cancel</a><button class="primary-button" type="submit">Post repair request</button></div></form></div></div>
