@model HomeCarePH.Domain.Entities.RepairRequest
@using HomeCarePH.Domain.Entities
@{ ViewData["Title"] = Model.Title; var canEdit = ViewData["CanEdit"] is true; var providers = ViewData["Providers"] as IReadOnlyList<ServiceProvider> ?? []; var activeBooking = Model.Bookings.OrderByDescending(x => x.CreatedAtUtc).FirstOrDefault(); }
<section class="page-heading"><div><a class="back-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId">← @Model.Property.Name</a><p class="eyebrow">Repair request</p><h1>@Model.Title</h1><p>@Model.Property.Name@(Model.Appliance is null ? "" : " · " + Model.Appliance.Name) · <strong>@Model.Status</strong></p></div><span class="priority-badge priority-@Model.Priority.ToString().ToLowerInvariant()">@Model.Priority priority</span></section>
@if (TempData["RepairMessage"] is string message) { <div class="notice">@message</div> }
<section class="repair-overview panel"><p class="eyebrow">Issue description</p><p class="repair-description">@Model.Description</p><small>Requested @Model.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy") by @Model.RequestedByUser.FullName@(Model.PreferredDate.HasValue ? " · Preferred " + Model.PreferredDate.Value.ToString("MMM d, yyyy") : "")</small></section>
@if (activeBooking is not null) { <section class="booking-banner"><span class="booking-icon">✓</span><span><b>Booking @activeBooking.Status</b><small>@activeBooking.ServiceProvider.BusinessName · @activeBooking.ScheduledStartUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</small></span></section> }
<div class="repair-detail-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Quotations</p><h2>Compare service offers</h2></div><span class="panel-mark">@Model.Quotations.Count</span></div>@if (Model.Quotations.Count == 0) { <p class="muted-copy">No quotations yet. Add a provider quote to begin comparing offers.</p> } else { <div class="quote-list">@foreach (var quote in Model.Quotations.OrderBy(x => x.Amount)) { <article class="quote-card"><div class="quote-card-heading"><div><b>@quote.ServiceProvider.BusinessName</b><small>@quote.ServiceProvider.Trade · valid until @quote.ValidUntilUtc.ToLocalTime().ToString("MMM d, yyyy")</small></div><strong>@quote.Amount.ToString("C")</strong></div><p>@quote.Description</p>@if (canEdit && quote.Status == QuotationStatus.Submitted && activeBooking is null) { <form asp-action="AcceptQuote" method="post" class="accept-quote-form"><input type="hidden" name="QuotationId" value="@quote.Id" /><input name="ScheduledStartUtc" type="datetime-local" required /><input name="Notes" placeholder="Booking notes (optional)" /><button class="secondary-button" type="submit">Accept and book</button></form> } else { <span class="role-badge">@quote.Status</span> }</article> }</div> }</section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Provider response</p><h2>Submit a quotation</h2></div></div><form class="compact-form" asp-action="SubmitQuote" method="post"><input type="hidden" name="RepairRequestId" value="@Model.Id" /><label>Service provider</label><select name="ServiceProviderId" required><option value="">Select provider</option>@foreach (var provider in providers) { <option value="@provider.Id">@provider.BusinessName</option> }</select><label>Amount</label><input name="Amount" type="number" min="0" step="0.01" required placeholder="0.00" /><label>Quotation details</label><textarea name="Description" rows="4" required placeholder="Scope of work and inclusions"></textarea><label>Valid until</label><input name="ValidUntilUtc" type="datetime-local" required /><button class="secondary-button" type="submit">Submit quotation</button></form></section></div>
@if (activeBooking is not null && activeBooking.Status == BookingStatus.Completed && !Model.Feedback.Any()) { <section class="panel feedback-panel"><p class="eyebrow">Repair history</p><h2>How did it go?</h2><form class="feedback-form" asp-action="AddFeedback" method="post"><input type="hidden" name="RepairRequestId" value="@Model.Id" /><input type="hidden" name="ServiceProviderId" value="@activeBooking.ServiceProviderId" /><select name="Rating" required><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Okay</option><option value="2">2 — Poor</option><option value="1">1 — Very poor</option></select><textarea name="Comments" rows="3" placeholder="Share feedback (optional)"></textarea><button class="secondary-button" type="submit">Save feedback</button></form></section>}
@if (Model.Feedback.Count > 0) { <section class="panel feedback-panel"><p class="eyebrow">Repair history</p><h2>Feedback</h2>@foreach (var feedback in Model.Feedback) { <div class="feedback-row"><b>@("★".PadRight(feedback.Rating, '★'))</b><span>@feedback.ServiceProvider.BusinessName · @feedback.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span><p>@feedback.Comments</p></div> }</section> }
