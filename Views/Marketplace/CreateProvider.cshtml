@model HomeCarePH.Models.CreateProviderViewModel
@{ ViewData["Title"] = "Add service provider"; }
<div class="form-page"><a class="back-link" asp-action="Providers">← Service providers</a><div class="form-card wide-form"><p class="eyebrow">Repair marketplace</p><h1>Add a service provider</h1><p class="auth-subtitle">Create a profile that households can review when requesting repair quotations.</p><form asp-action="CreateProvider" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="BusinessName"></label><input asp-for="BusinessName" placeholder="Business name" autofocus /><span asp-validation-for="BusinessName"></span><label asp-for="ContactName"></label><input asp-for="ContactName" placeholder="Primary contact" /><span asp-validation-for="ContactName"></span><div class="form-two-col"><div><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span></div><div><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" /><span asp-validation-for="PhoneNumber"></span></div><div><label asp-for="Trade"></label><input asp-for="Trade" placeholder="Plumber, HVAC, electrician..." /></div></div><label asp-for="Description"></label><textarea asp-for="Description" rows="4" placeholder="Describe services and experience"></textarea><span asp-validation-for="Description"></span><div class="form-actions"><a class="secondary-button button-link" asp-action="Providers">Cancel</a><button class="primary-button" type="submit">Save provider</button></div></form></div></div>
