@model IReadOnlyList<HomeCarePH.Domain.Entities.ServiceProvider>
@{ ViewData["Title"] = "Service providers"; }
<section class="page-heading"><div><p class="eyebrow">Repair marketplace</p><h1>Service providers</h1><p>Browse technicians and providers by trade and coverage area.</p></div><a class="primary-button button-link" asp-action="CreateProvider">+ Add provider</a></section>
@if (Model.Count == 0) { <div class="empty-state"><h2>No providers yet</h2><p>Add the first local service provider to start collecting repair quotations.</p><a class="primary-button button-link" asp-action="CreateProvider">Add provider</a></div> } else { <div class="provider-grid">@foreach (var provider in Model) { <a class="provider-card" asp-action="ProviderDetails" asp-route-id="@provider.Id"><div class="provider-avatar">@provider.BusinessName.Substring(0, 1).ToUpperInvariant()</div><div><h2>@provider.BusinessName</h2><p>@(provider.Trade ?? "General service provider")</p><small>@provider.ServiceAreas.Count service area@(provider.ServiceAreas.Count == 1 ? "" : "s")</small></div><span class="card-arrow">→</span></a> }</div> }
