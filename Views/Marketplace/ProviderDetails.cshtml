@model HomeCarePH.Domain.Entities.ServiceProvider
@{ ViewData["Title"] = Model.BusinessName; }
<section class="page-heading"><div><a class="back-link" asp-action="Providers">← Service providers</a><p class="eyebrow">Provider profile</p><h1>@Model.BusinessName</h1><p>@(Model.Trade ?? "General service provider") · @Model.ContactName</p></div></section>
@if (TempData["ProviderMessage"] is string message) { <div class="notice">@message</div> }
<section class="provider-profile panel"><div class="provider-avatar large-avatar">@Model.BusinessName.Substring(0, 1).ToUpperInvariant()</div><div><p class="eyebrow">About this provider</p><p>@(Model.Description ?? "No profile description added yet.")</p><div class="provider-contact"><span>@Model.Email</span><span>@(Model.PhoneNumber ?? "Phone not added")</span></div></div></section>
<div class="provider-detail-grid"><section class="panel"><p class="eyebrow">Service areas</p><h2>Where they work</h2>@if (Model.ServiceAreas.Count == 0) { <p class="muted-copy">No service areas added yet.</p> } else { <div class="area-list">@foreach (var area in Model.ServiceAreas) { <div><b>@area.City</b><small>@area.Province @(area.RadiusKm.HasValue ? "· " + area.RadiusKm + " km radius" : "")</small></div> }</div> }<form class="compact-form" asp-action="AddServiceArea" method="post"><input type="hidden" name="ServiceProviderId" value="@Model.Id" /><div class="form-two-col"><input name="City" placeholder="City" required /><input name="Province" placeholder="Province / state" /></div><div class="form-two-col"><input name="PostalCode" placeholder="Postal code" /><input name="RadiusKm" type="number" min="0" max="500" placeholder="Radius (km)" /></div><button class="secondary-button" type="submit">+ Add service area</button></form></section><section class="panel"><p class="eyebrow">Marketplace activity</p><h2>Quotations</h2>@if (Model.Quotations.Count == 0) { <p class="muted-copy">No quotations submitted yet.</p> } else { <div class="quote-mini-list">@foreach (var quote in Model.Quotations.OrderByDescending(x => x.SubmittedAtUtc)) { <div><b>@quote.RepairRequest.Title</b><small>@quote.Amount.ToString("C") · @quote.Status</small></div> }</div> }</section></div>
