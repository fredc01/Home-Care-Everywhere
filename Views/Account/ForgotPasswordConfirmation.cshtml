@{ ViewData["Title"] = "Check your email"; var resetLink = TempData["ResetLink"] as string; }
<div class="auth-page"><div class="auth-card"><p class="eyebrow">Account recovery</p><h1>Reset link prepared</h1><p class="auth-subtitle">If an account matches that email, a reset link is ready. In this foundation build, the development link is shown below so the flow can be tested before email delivery is connected.</p>@if (!string.IsNullOrWhiteSpace(resetLink)) { <a class="reset-link" href="@resetLink">Open password reset link</a> }<p class="auth-foot"><a asp-action="Login">Return to sign in</a></p></div></div>
