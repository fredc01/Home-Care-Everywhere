@model HomeCarePH.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "Choose a new password"; }
<div class="auth-page"><div class="auth-card"><p class="eyebrow">Account recovery</p><h1>Choose a new password</h1><form asp-action="ResetPassword" method="post"><input asp-for="UserId" type="hidden" /><input asp-for="Code" type="hidden" /><input asp-for="Email" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span><button class="primary-button" type="submit">Update password</button></form></div></div>
