@model HomeCarePH.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<div class="auth-page"><div class="auth-card"><p class="eyebrow">Account recovery</p><h1>Reset your password</h1><p class="auth-subtitle">Enter your email and we’ll prepare a secure reset link.</p><form asp-action="ForgotPassword" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span><button class="primary-button" type="submit">Prepare reset link</button></form><p class="auth-foot"><a asp-action="Login">Back to sign in</a></p></div></div>
